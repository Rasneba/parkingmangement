# Database (shared with the existing Genius ERP)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/genius_hrms"

# JWT signing secret. MUST match the ERP secret so tokens are interchangeable.
JWT_SECRET="change-me-to-a-long-random-string"

# Public base URL of this app
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Environment: development | production
NODE_ENV="development"

# Optional: company used by the seed script (defaults to the first company)
# COMPANY_ID="1"

# Optional: login created by `npm run init` on an empty/standalone database
# (Neon etc.). Defaults to admin@parking.local / Parking@123.
# SEED_ADMIN_EMAIL="admin@parking.local"
# SEED_ADMIN_PASSWORD="Parking@123"
# SEED_ADMIN_NAME="Parking Admin"

# --- Optional future device integrations (leave blank to disable) ---
# Access controller used by /api/parking/access (required for that endpoint)
PARKING_CONTROLLER_IP=""
PARKING_CONTROLLER_USER=""
PARKING_CONTROLLER_PASSWORD=""
# Shared key required by /api/parking/access/swipes when set (recommended)
PARKING_RELAY_KEY=""
# Barrier / access controller relay (TCP)
PARKING_RELAY_HOST=""
PARKING_RELAY_PORT=""
# ANPR / LPR camera bridge
PARKING_ANPR_BRIDGE_URL=""
# RFID reader bridge
PARKING_RFID_BRIDGE_URL=""

# --- Optional online payment gateways ---
CHAPA_SECRET_KEY=""
ADDISPAY_SECRET_KEY=""
ADDISPAY_API_URL=""
