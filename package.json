    "migrate:down": "node scripts/migrate.js --down",
    "seed": "node scripts/seed.js",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.3",
