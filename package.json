{
  "name": "parking-management",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Parking Management System built on the Genius ERP foundation",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build --webpack",
    "build:turbo": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
